# ---------- Neon (Postgres) ----------
# Lấy từ Neon Console -> Connection string (Pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ---------- Anthropic Claude ----------
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL="claude-sonnet-5"

# ---------- Cloudflare R2 ----------
# Cloudflare Dashboard -> R2 -> Manage API Tokens
R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_BUCKET="audit-findings"
# (Tuỳ chọn) Public domain nếu bucket được public qua r2.dev hoặc custom domain
R2_PUBLIC_BASE_URL=""

# ---------- App ----------
NEXT_PUBLIC_APP_NAME="Chuẩn hoá Finding ISO"
