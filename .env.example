# ---------- Neon (Postgres) ----------
# Lấy từ Neon Console -> Connection string (Pooled connection)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ---------- Xác thực ----------
# BẮT BUỘC, tối thiểu 16 ký tự. Dùng để ký cookie phiên của trưởng đoàn và
# đánh giá viên. Thiếu biến này thì mọi lần đăng nhập đều "thành công" rồi bị
# đá ra ngay — không có thông báo lỗi nào chỉ đúng nguyên nhân.
# Sinh chuỗi ngẫu nhiên:  openssl rand -base64 32
AUTH_SECRET=""

# ---------- Anthropic Claude ----------
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL="claude-sonnet-5"
# Số lượt chuẩn hoá tối đa của MỘT người trong MỘT giờ (cửa sổ trượt).
# Bỏ trống thì mặc định 20. Xem src/lib/ai-quota.ts.
AI_HOURLY_LIMIT="20"

# ---------- Cloudflare R2 ----------
# Cloudflare Dashboard -> R2 -> Manage API Tokens
R2_ACCOUNT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
R2_BUCKET="audit-findings"
# (Tuỳ chọn) Public domain nếu bucket được public qua r2.dev hoặc custom domain
R2_PUBLIC_BASE_URL=""

# ---------- App ----------
NEXT_PUBLIC_APP_NAME="Chuẩn hoá Finding ISO"
